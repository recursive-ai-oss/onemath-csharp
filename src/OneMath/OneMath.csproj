<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>$(PackageBaseName)</AssemblyName>
    <RootNamespace>RecursiveAI.OneMath</RootNamespace>
    <PackageId>$(PackageBaseName)</PackageId>
    <Description>Deterministic math for .NET: vectors, matrices, quaternions, transcendental functions and exact predicates with identical results on every platform and across every release of a major version.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageTags>math;deterministic;determinism;lockstep;rollback;vector;matrix;quaternion;transcendental;correctly-rounded;exact-predicates;orient2d;incircle;fixed-point;nativeaot;trimmable</PackageTags>
    <PackageReleaseNotes>See CHANGELOG.md in the repository.</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Compare the public API with the last release; set PackageValidationBaselineVersion after each release. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.1.0-preview.5</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../PACKAGE.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE-MIT" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE-APACHE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-time analyzer only; nothing is referenced at run time. -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)../../BannedSymbols.txt" />
  </ItemGroup>

</Project>
