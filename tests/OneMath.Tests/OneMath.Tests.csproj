  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneMath/OneMath.csproj" />
    <ProjectReference Include="../../tools/HashMatrix/HashMatrix.csproj" />
  </ItemGroup>

</Project>
